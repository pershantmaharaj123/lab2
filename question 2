name = input("Enter student name: ")
roll_no = input("Enter roll number: ")

marks = []

for i in range(1, 6):
    mark = float(input(f"Enter marks for subject {i}: "))
    marks.append(mark)

total = sum(marks)
percentage = total / 5

if percentage >= 80:
    grade = "A+"
elif percentage >= 70:
    grade = "A"
elif percentage >= 60:
    grade = "B"
elif percentage >= 50:
    grade = "C"
elif percentage >= 40:
    grade = "D"
else:
    grade = "F"

if any(mark < 40 for mark in marks):
    result = "Fail"
else:
    result = "Pass"

print("\n===== STUDENT MARKSHEET =====")
print("Name:", name)
print("Roll No:", roll_no)

for i in range(5):
    print(f"Subject {i + 1}: {marks[i]}")

print("Total Marks:", total)
print("Percentage:", percentage)
print("Grade:", grade)
print("Result:", result)
